  202|  11.3k|            if self.builder.has_insert_block_terminator() {
  203|       |                // if the current block has a terminator, don't generate anything since it's
  204|       |                // unreachable
  205|       |                // TODO: Warn about unreachable code
  206|    107|                break;
  207|  11.2k|            }
  208|       |
  209|  11.2k|            match statement {
  210|  8.36k|                BlockItem::Statement(statement) => self.codegen_statement(statement),
  211|  2.83k|                BlockItem::Declaration(declaration) => {
  212|  2.83k|                    self.codegen_declaration(declaration);
  213|  2.83k|                }
  214|       |            }
  215|       |        }
  216|       |
  217|       |        // Check if the last block has a terminator
  218|       |        #[expect(clippy::expect_used)]
  219|  2.45k|        let basic_block = self.builder.get_insert_block().expect("No insert block");
  220|       |
  221|  2.45k|        if basic_block.terminator().is_none() {
  222|       |            // TODO: What about void function
  223|  2.33k|            if function.name == "main" {
  224|    226|                // If main is missing a terminator add return 0
  225|    226|                let zero = self.const_int(0);
  226|    226|                self.builder.ret(zero);
  227|  2.10k|            } else {
