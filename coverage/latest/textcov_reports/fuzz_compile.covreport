_RNvMs0_CshbBfnB6CBsC_14rustcc_codegenNtB5_7Codegen30codegen_unary_prefix_increment:
  751|    182|    fn codegen_unary_prefix_increment(&self, expression: &Expression) -> LLVMValue {
  752|       |        // The operand of a prefix increment must be an l-value.
  753|    182|        let Some(name) = expression.as_variable_name() else {
  754|      0|            panic!("operand of prefix increment must be an l-value");
  755|       |        };
  756|       |
  757|       |        // First load the current value of the variable
  758|    182|        let current_value = self.load_variable(name);
  759|       |
