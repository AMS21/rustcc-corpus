  778|       |        // First load the current value of the variable
  779|    299|        let current_value = self.load_variable(name);
  780|       |
  781|       |        // Then subtract 1 from it
  782|    299|        let one = self.const_int(1);
  783|    299|        let new_value = self.builder.subtract(current_value, one);
  784|       |
